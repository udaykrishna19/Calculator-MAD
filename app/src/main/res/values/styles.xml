<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalculatorButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item> <!-- Fixed height -->
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_columnWeight">1</item> <!-- Add this -->
        <item name="android:layout_rowWeight">1</item> <!-- Add this -->
        <item name="android:textSize">24sp</item>
<!--        <item name="android:backgroundTint">#F0F0F0</item>-->
<!--        <item name="android:textColor">#000000</item>-->
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">#000000</item> <!-- Black text -->
        <item name="android:backgroundTint">#F0F0F0</item> <!-- Light gray background -->
    </style>

    <style name="CalculatorOperatorButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:backgroundTint">#FF9800</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>